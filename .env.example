# Hearth-Core: environment variables
#
# HEARTH is three repos that run side by side (github.com/HEARTH-STAR):
#
#   Hearth-frontend  web app                  http://127.0.0.1:4310  calls this API in each Space
#   Hearth-Core      this service             :5010 inside each Space's container
#   Hearth-backend   container spin-up        http://127.0.0.1:5020  its space template clones this
#                                                                    repo's main and runs it on 5010
#
# Each Space in the web app is a container running this service; Hearth-frontend reaches it at
# the 127.0.0.1 port Docker published for 5010, and signs Claude Code and GitHub in through it.
#
# Every key, documented. On a laptop copy this file to .env; inside a container the
# same keys come from the environment.
#
# Precedence, lowest to highest: defaults in code → .env → exported shell vars.

# ──────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1                  # loopback only. Never 0.0.0.0 outside the space container
PORT=5010                       # the space container publishes this port on loopback
UVICORN_RELOAD=false            # true = restart on code changes (development only)
LOG_LEVEL=INFO

# Install nothing at boot. The space image preloads the claude CLI; set to 0 on a
# laptop to let config/agents/claude_code/setup.sh install it.
HEARTH_SKIP_BOOT_INSTALL=1

# ──────────────────────────────────────────────────────────────────────────
# Agent backend
# ──────────────────────────────────────────────────────────────────────────
# claude_code (the default when nothing is set: its manifest says "default": true), cursor or antigravity.
AGENT_NAME=claude_code
# DEFAULT_AGENT=claude_code
HEARTH_MODEL=claude-opus-5-5    # claude_code: overrides manifest.json model.default
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# cursor (AGENT_NAME=cursor): Cursor's agent CLI, signed in with `cursor-agent login`
# (or Connect Cursor in the web app) or with an API key.
# HEARTH_CURSOR_MODEL=auto      # overrides config/agents/cursor/manifest.json; auto = Cursor picks
# CURSOR_CLI_PATH=~/.local/bin/cursor-agent
# CURSOR_API_KEY=
# CURSOR_HOME=~/.cursor

# antigravity (AGENT_NAME=antigravity): Google Antigravity's agy CLI, signed in with a Google account
# (Connect Antigravity in the web app, or `agy` once in a terminal). No API key.
# HEARTH_ANTIGRAVITY_MODEL=Gemini 3.5 Flash (Low)   # a name from `agy models`
# AGY_CLI_PATH=~/.local/bin/agy

# ──────────────────────────────────────────────────────────────────────────
# LLM credentials (bring your own LLM). One of:
# ──────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_BASE_URL=http://127.0.0.1:4000   # the space's LLM gateway
# ANTHROPIC_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Paths
# ──────────────────────────────────────────────────────────────────────────
# Machine-local state: secrets/token.json (GitHub credential METADATA only — the
# token lives in gh), mirrors/, checkouts/, workspaces/, jobs/, audit/.
# In a space: the space volume, e.g. /var/lib/hearth
HEARTH_STATE_DIR=~/.hearth
# HEARTH_TOKENS_FILE=            # override token.json location

# The workspace chat turns (POST /api/chat) run in; Hearth-frontend gives each Dot a
# folder here (dots/<name>-<id>) and reads it through /api/workspace/files. Default:
# $HEARTH_STATE_DIR/workspace. In a Hearth-backend container: /workspace, the
# template's workspace, where it clones its repos.
# HEARTH_WORKSPACE_DIR=/workspace
